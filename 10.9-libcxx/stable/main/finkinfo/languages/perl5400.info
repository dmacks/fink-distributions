CompileScript: <<
#!/bin/sh -ev
	if [[ `sw_vers -productVersion | cut -f 1 -d.` -ge 11 ]]; then
		# race condition on macOS11 causes miniperl to not propagate sometimes
		ABSPERL=../../miniperl
		# /usr/lib/libc* no longer exists
		perl -pi -e 's,win32|vms|openbsd|bitrig|cygwin,$&|darwin,g' ext/DynaLoader/t/DynaLoader.t
	fi
	sleep 5
	sh Configure \
	-desr \
	-Dcc="gcc" \
	-Dcpp="gcc -E" \
	-Dprefix=%p \
	-Dccflags="-I%p/include -MD" \
	-Dldflags=-L%p/lib \
	-Dperladmin=none \
	-Uinstallusrbinperl \
	-Dprivlib="%p/lib/perl5-core/5.40.0" \
	-Darchlib="%p/lib/perl5-core/5.40.0/darwin-thread-multi-2level" \
	-Dman3dir="%p/lib/perl5-core/5.40.0/man/man3" \
	-Dman3ext=3pm \
	-Dscriptdir="%p/bin" \
	-Duseithreads \
	-Dinc_version_list=none \
	-Dcf_by="Fink Project" \
	-Dcf_email="fink-core@lists.sourceforge.net" \
	-Umydomain \
	-Dmyhostname="localhost" \
	-Adefine:startperl="#!%p/bin/perl5.40.0" \
	-Adefine:perlpath="%p/bin/perl5.40.0" \
	-Dnoextensions="GDBM_File NDBM_File"
	make
<<
